# Port published on the host.
PYPIHUB_PORT=5000

# Account that is created (or whose password is reset) every time the container starts.
# Needed to upload packages. Leave both empty to manage users with:
#   docker compose exec pypihub pypihub user -u NAME
PYPIHUB_ADMIN_USER=
PYPIHUB_ADMIN_PASSWORD=

# Signs sign-in cookies. Leave empty to generate and keep one inside the data volume.
PYPIHUB_SECRET_KEY=

# Set to 1 only when a reverse proxy in front sets X-Forwarded-Proto and X-Forwarded-Host.
PYPIHUB_TRUST_PROXY=

# --- docker-compose.production.yml ---------------------------------------------------
POSTGRES_PASSWORD=
# Largest size the PyPI cache may reach before new files are streamed without being stored.
PYPIHUB_CACHE_MAX_SIZE=100GB
# Requests per client address, e.g. "1200 per minute". Leave empty for no general limit.
PYPIHUB_RATE_LIMIT_DEFAULT=1200 per minute
WEB_CONCURRENCY=4
GUNICORN_THREADS=8

# --- package pages ------------------------------------------------------------------
# Details shown on a package page (README, links, release history) are copied from PyPI, kept in the database
# and refreshed after this many seconds. Set PYPIHUB_META=0 to turn the feature off.
# Two lifetimes. The database copy is fresh for PYPIHUB_META_TTL; Redis keeps its hot copy for PYPIHUB_META_CACHE_TTL,
# which must not be longer. When the Redis entry expires the database answers, so PyPI is asked only every 6 hours.
# default 21600 seconds (6 hours)
PYPIHUB_META_TTL=21600
# default 3600 seconds (1 hour); 0 = keep nothing in Redis
PYPIHUB_META_CACHE_TTL=3600
# default 3600 seconds
#PYPIHUB_META_MISSING_TTL=

# --- download counts on package pages (from pypistats.org, which limits requests per address) ---------------------
# Set to 0 to hide them.
PYPIHUB_STATS=1
# Same two lifetimes: database 6 hours, Redis 1 hour.
PYPIHUB_STATS_TTL=21600
PYPIHUB_STATS_CACHE_TTL=3600
# Only needed for an upstream other than pypi.org, or your own statistics service.
#PYPIHUB_STATS_URL=

DATABASE_URL=postgresql://pypihub_admin:changeme@pgbouncer:6432/pypihub
REDIS_URL=redis://:changeme@redis:6379/11
SECRET_KEY=changemelove

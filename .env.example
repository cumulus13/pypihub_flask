# Port published on the host.
PYPIHUB_PORT=5000

# Account that is created (or whose password is reset) every time the container starts.
# Needed to upload packages. Leave both empty to manage users with:
#   docker compose exec pypihub pypihub user -u NAME
PYPIHUB_ADMIN_USER=
PYPIHUB_ADMIN_PASSWORD=

# Signs sign-in cookies. Leave empty to generate and keep one inside the data volume.
PYPIHUB_SECRET_KEY=

# Set to 1 only when a reverse proxy in front sets X-Forwarded-Proto and X-Forwarded-Host.
PYPIHUB_TRUST_PROXY=

# --- docker-compose.production.yml ---------------------------------------------------
POSTGRES_PASSWORD=
# Largest size the PyPI cache may reach before new files are streamed without being stored.
PYPIHUB_CACHE_MAX_SIZE=100GB
# Requests per client address, e.g. "1200 per minute". Leave empty for no general limit.
PYPIHUB_RATE_LIMIT_DEFAULT=1200 per minute
WEB_CONCURRENCY=4
GUNICORN_THREADS=8

# --- package pages ------------------------------------------------------------------
# Details shown on a package page (README, links, release history) are copied from PyPI, kept in the database
# and refreshed after this many seconds. Set PYPIHUB_META=0 to turn the feature off.
PYPIHUB_META_TTL=21600
